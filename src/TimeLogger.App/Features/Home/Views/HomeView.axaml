<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:TimeLogger.App.Features.Home.Models"
             xmlns:vm="using:TimeLogger.App.Features.Home.ViewModels"
             mc:Ignorable="d"
             x:Class="TimeLogger.App.Features.Home.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             d:DesignWidth="1100"
             d:DesignHeight="700">

  <Grid Margin="14,6,14,8" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="10">
    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,4,0,2">
      <StackPanel Spacing="2">
        <TextBlock Text="Your workday" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Log your time and keep your schedule close." Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
        <Button Content="Export day" Classes="pill" Command="{Binding ExportDayCsvCommand}"/>
        <Button Content="Export range" Classes="pill" Command="{Binding ExportRangeCsvCommand}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
      <Border Background="{DynamicResource CardBrush}"
              CornerRadius="4"
              Padding="8,4"
              PointerPressed="OnDateContainerPressed">
        <Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" IsHitTestVisible="False">
            <TextBlock Text="📅" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedDateDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" />
          </StackPanel>
          <CalendarDatePicker x:Name="EntryDatePicker"
                              SelectedDate="{Binding SelectedDate}"
                              Opacity="0"
                              Width="1"
                              Height="1"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top" />
        </Grid>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Start" VerticalAlignment="Center"/>
        <ComboBox Width="110"
                  ItemsSource="{Binding TimeOptions}"
                  SelectedItem="{Binding SelectedStartTime}"
                  DropDownOpened="OnTimeDropDownOpened" />
      </StackPanel>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="End" VerticalAlignment="Center"/>
        <ComboBox Width="110"
                  ItemsSource="{Binding TimeOptions}"
                  SelectedItem="{Binding SelectedEndTime}"
                  DropDownOpened="OnTimeDropDownOpened" />
      </StackPanel>

      <TextBlock Grid.Column="5"
                 Text="{Binding TotalDuration, StringFormat=Total\: {0}}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"/>
    </Grid>

    <Grid Grid.Row="2" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock Text="TASK" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold" />
        <ComboBox ItemsSource="{Binding TaskOptions}"
                  SelectedItem="{Binding SelectedTask}"
                  Height="34"
                  HorizontalAlignment="Stretch"/>
      </StackPanel>

      <StackPanel Grid.Row="1" Spacing="6">
        <TextBlock Text="NOTES" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold" />
        <TextBox Height="130"
                 Text="{Binding Notes}"
                 TextWrapping="Wrap"
                 Watermark="Add notes here..."
                 AcceptsReturn="True"
                 VerticalContentAlignment="Top"
                 HorizontalAlignment="Stretch"/>
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
        <Button Content="+  Add entry" Classes="pill primary" Command="{Binding AddEntryCommand}"/>
        <Button Content="Delete selected" Classes="pill" Command="{Binding DeleteSelectedCommand}"/>
      </StackPanel>

      <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="10">
        <ListBox ItemsSource="{Binding WorkEntries}"
                 SelectedItem="{Binding SelectedEntry}"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 DoubleTapped="OnEntriesListDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:WorkEntry">
              <Border Padding="10" Margin="0,0,0,8" Background="{DynamicResource CardBrush}" CornerRadius="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Task}" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Text="{Binding DateLabel}"/>
                  <TextBlock Text="{Binding TimeRange}"/>
                  <TextBlock Text="{Binding Notes}" Opacity="0.85" TextWrapping="Wrap"/>
                  <Button Content="Notes" Classes="pill" IsVisible="{Binding HasMeetingNotes}" Click="OnEntryMeetingNotesClicked" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <TextBlock Grid.Row="4" Text="{Binding EntryCountLabel}" FontWeight="SemiBold"/>
    </Grid>

    <Border Grid.Row="2"
            Grid.Column="1"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="14"
            Padding="18"
            VerticalAlignment="Stretch"
            Margin="0,0,0,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Text="Outlook Calendar" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

          <ComboBox Grid.Column="1"
                    Width="130"
                    ItemsSource="{Binding QuickRanges}"
                    SelectedItem="{Binding SelectedCalendarRange}"
                    HorizontalAlignment="Right" />
          <Button Grid.Column="2"
                  Content="Refresh"
                  Classes="pill"
                  Command="{Binding RefreshCalendarCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding CalendarGroupLabel}" FontStyle="Italic" Opacity="0.95"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding CalendarEvents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:CalEvent">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DateLine}"/>
                    <TextBlock Text="{Binding TimeRange}"/>
                    <TextBlock Text="{Binding Location}" Opacity="0.85"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="View details  →" Classes="pill" Click="OnMeetingDetailsClicked" Margin="0,0,8,6" />
                      <Button Content="Notes" Classes="pill" Click="OnMeetingNotesClicked" Margin="0,0,8,6" />
                      <Button Content="Add to time log" Classes="pill" Click="OnMeetingToTimeLogClicked" Margin="0,0,0,6" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding EventCountLabel}" FontWeight="SemiBold" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
