<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeLogger.App.Features.Home.Views.Dialogs.MeetingDetailsWindow"
        Width="620" Height="650" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        Title="Meeting details">
  <Grid RowDefinitions="*,Auto" Margin="18" RowSpacing="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <TextBlock x:Name="SubjectText" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="ScheduleText" TextWrapping="Wrap" />
        <TextBlock x:Name="LocationText" TextWrapping="Wrap" />
        <TextBlock x:Name="OrganizerText" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        <TextBlock x:Name="CategoriesText" TextWrapping="Wrap" />
        <TextBlock Text="Attendees" FontWeight="Bold" Margin="0,5,0,0" />
        <TextBlock x:Name="AttendeesText" TextWrapping="Wrap" />
        <TextBlock Text="Description" FontWeight="Bold" Margin="0,5,0,0" />
        <TextBox x:Name="DescriptionText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="JoinButton" Content="Join meeting" Click="OnJoinClicked" />
      <Button x:Name="OutlookButton" Content="Open in Outlook" Click="OnOutlookClicked" />
      <Button Content="Close" Click="OnCloseClicked" />
    </StackPanel>
  </Grid>
</Window>
